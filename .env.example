# Copier vers .env.local (ne jamais committer .env.local)

NEXT_PUBLIC_SITE_URL=https://crm.groupe-kalao.com

# Projet Supabase → Settings → API
# Dans Authentication → URL Configuration :
#   Site URL = https://crm.groupe-kalao.com
#   Redirect URLs = https://crm.groupe-kalao.com/**
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Le CRM expose déjà une API interne /api/v1/{companies,contacts,leads,deals,catalog,quotes,invoices,activities}
# Les API externes (paiement, e-mail, SMS, etc.) seront branchées ensuite.

# Côté serveur uniquement — ne jamais préfixer NEXT_PUBLIC_ ni coller cette clé dans le chat
SUPABASE_SERVICE_ROLE_KEY=
